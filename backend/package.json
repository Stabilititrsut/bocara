{
  "name": "bocara-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && find routes services middleware scripts -maxdepth 2 -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js && node scripts/test-checkout-validation.js && node scripts/test-webhook-cubo.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.20.0",
    "stripe": "^14.5.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "docx": "^9.7.1"
  }
}
