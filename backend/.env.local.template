# ─────────────────────────────────────────────────────────────────────────────
# Bocara backend — entorno LOCAL mínimo (pruebas manuales de publicaciones,
# login, restaurante, admin y cliente). Plantilla SIN secretos: se versiona.
#
# Uso: scripts/setup-local-env.ps1 la copia a backend/.env (ignorado por Git),
# completa SUPABASE_URL (pública) y genera un JWT_SECRET local. Solo hay que
# pegar a mano SUPABASE_SERVICE_KEY.
#
# Variables verificadas contra el código real (process.env.* en server.js,
# config/, routes/, services/, middleware/), no contra .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Obligatorias para arrancar ──────────────────────────────────────────────
# config/supabase.js: createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY) lanza
# "supabaseUrl is required" / "supabaseKey is required" si faltan.
# SUPABASE_URL no es secreta (la app la incluye en src/services/supabase.ts).
SUPABASE_URL=
# Supabase Dashboard → Project Settings → API → service_role (SECRETA).
SUPABASE_SERVICE_KEY=

# Firma y verifica los tokens de sesión (login, rutas autenticadas, admin).
# Para local basta un valor aleatorio propio: el backend local emite y valida
# sus propios tokens. No hace falta (ni conviene) usar el de producción.
JWT_SECRET=

# ── Seguridad del entorno local ─────────────────────────────────────────────
# Desactiva las tareas en segundo plano de server.js (recordatorios push,
# reintentos post-pago, barridos de pedidos/reservas). Si este backend apunta
# a la misma base que producción, sin esto mandaría push duplicados a clientes
# reales y procesaría pagos en paralelo con Render.
BOCARA_DISABLE_JOBS=true

# ── Pagos: deshabilitados ───────────────────────────────────────────────────
# routes/pagos.js corta todo el flujo de Cubo si no es 'true'. Con
# CUBO_ENVIRONMENT vacío no corre la validación de arranque de producción.
CUBO_PAYMENTS_ENABLED=false
CUBO_CURRENCY=GTQ

# ── Opcionales (no hacen falta para estas pruebas; vacías = desactivado) ────
# RESEND_API_KEY=         # emails (aprobación de negocio, OTP por email)
# EXPO_ACCESS_TOKEN=      # push; sin él se envía sin auth o se omite
# TWILIO_ACCOUNT_SID=     # OTP por SMS
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# ADMIN_SETUP_SECRET=     # solo endpoints de bootstrap de admin
# FRONTEND_URL=           # links en correos/pagos (default bocarafood.com)

# ── Pruebas por LAN (otra máquina de la misma red abriendo la app web) ─────
# middleware/cors.js ya acepta cualquier IP privada RFC1918 (10.x, 172.16-31.x,
# 192.168.x.x) en cualquier puerto mientras NODE_ENV no sea production — no
# hace falta nada aquí para esas. Si tu IP de LAN NO cae en esos rangos (ej.
# 198.168.x.x, que es una IP pública, no privada), agrégala explícitamente:
# CORS_EXTRA_ORIGINS=http://198.168.21.19:8085
# (si usas varios puertos de frontend a la vez, sepáralos por coma).
