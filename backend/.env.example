# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...  # Settings → API → service_role key

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...      # sk_test_... en desarrollo
STRIPE_WEBHOOK_SECRET=whsec_...    # Stripe Dashboard → Webhooks

# ─── PayU Latam ───────────────────────────────────────────
PAYU_MERCHANT_ID=TU_MERCHANT_ID
PAYU_API_KEY=TU_API_KEY
PAYU_API_LOGIN=TU_API_LOGIN
PAYU_ACCOUNT_ID=TU_ACCOUNT_ID
PAYU_SANDBOX=true                  # false en producción

# ─── Email (Resend) ────────────────────────────────────────
# resend.com/api-keys — requiere el dominio bocarafood.com verificado en
# Resend (Settings → Domains) para poder enviar desde no-reply@bocarafood.com.
RESEND_API_KEY=re_...

# ─── Email (Gmail SMTP) — respaldo desactivado ────────────
# Render bloquea/degrada las conexiones SMTP salientes, así que este camino
# está comentado en services/email.js. Solo hace falta si algún día se
# vuelve a ese código. Usa una Contraseña de Aplicación de Google
# (myaccount.google.com → Seguridad → Contraseñas de aplicaciones).
# EMAIL_USER=tucorreo@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop   # App Password de 16 caracteres (sin espacios al configurar)

# ─── Expo Push Notifications ──────────────────────────────
EXPO_ACCESS_TOKEN=TU_EXPO_TOKEN    # expo.dev → Account → Access Tokens

# ─── URLs ─────────────────────────────────────────────────
API_BASE_URL=https://api.bocarafood.com   # URL pública del backend

# ─── Delivery (tarifas base en GTQ) ───────────────────────
DELIVERY_BASE_FEE_GTM_CITY=15
DELIVERY_BASE_FEE_METRO=25
DELIVERY_BASE_FEE_INTERIOR=50

# ─── Guatex (opcional) ────────────────────────────────────
GUATEX_API_URL=https://api.guatex.com.gt/v1
GUATEX_API_KEY=TU_KEY

# ─── Forza Delivery (opcional) ────────────────────────────
FORZA_API_URL=https://api.forzadelivery.com/v2
FORZA_API_KEY=TU_KEY

# ─── EasyPost (opcional) ──────────────────────────────────
EASYPOST_API_KEY=TU_KEY

# ─── Cubo Pago Guatemala — https://developers.cubopago.com ───────────────────
# Producción (configurar en Render Dashboard — nunca hardcodear en código)
CUBO_API_URL=https://api-payment-a.cubopago.com
CUBO_API_KEY=TU_API_KEY_PRODUCCION          # Cubo Admin → Developers → API Keys
CUBO_ENVIRONMENT=production                 # "production" activa validación al iniciar
CUBO_PAYMENTS_ENABLED=false                 # cambiar a true solo tras verificar config completa
CUBO_CURRENCY=GTQ                           # moneda confirmada por Cubo Pago Guatemala — cuenta configurada en quetzales

# Caducidad del link de pago (AC-03) ────────────────────────────────────────
# El link de Cubo debe morir a la vez que la reserva de stock (15 min,
# RESERVA_TTL_MINUTOS en services/stock.js). La marca de vigencia viaja SIEMPRE
# en metadata.expiraEn; estas dos variables son para que Cubo la aplique de
# verdad, y son opt-in porque el campo no está documentado y un nombre que su
# validador no reconozca devuelve 422.
#   1. Confirmar con soporte de Cubo el nombre exacto del campo de expiración
#      de POST /api/v1/links/one-use.
#   2. Ponerlo aquí y probar en sandbox ANTES de tocar producción.
# Sin esto el pago tardío sigue cubierto (el webhook lo rechaza y el barrido
# cierra el pedido), pero el cliente puede llegar a pagar y necesitar reembolso.
# CUBO_LINK_EXPIRACION_CAMPO=expiresAt      # nombre del campo en la API de Cubo
# CUBO_LINK_EXPIRACION_FORMATO=iso          # iso (por defecto) | epoch | epoch_ms | minutos

# Desarrollo local / sandbox
# CUBO_API_URL=https://api-payment-sandbox.cubopago.com
# CUBOPAGO_API_KEY=TU_API_KEY_SANDBOX       # fallback dev (no usar en producción)
# CUBO_ENVIRONMENT=sandbox

# ── Imagen con IA OBLIGATORIA para publicar (docs/IA_IMAGEN_PUBLICACIONES.md) ─
# Sin IMAGE_AI_PROVIDER=openai + OPENAI_API_KEY NO se puede publicar ninguna
# Promoción ni Tiempo limitado: cada foto debe analizarse, mejorarse y validarse.
# El servidor lo dice al arrancar ([IA] Imagen: NO OPERATIVA — falta ...).
# OPENAI_VISION_MODEL=gpt-6-luna                              # revisión "¿es presentable?" (Responses API + visión)
# IMAGE_AI_MAX_TRABAJOS_POR_HORA=20                           # fotos procesadas por restaurante
# IMAGE_AI_MAX_TRABAJOS_POR_DIA=60
# IMAGE_QUALITY_MIN_LADO=600                                  # calidad mínima (calibrar: node scripts/probar-calidad-imagen.js)
# IMAGE_QUALITY_MAX_PROPORCION=2.0
# IMAGE_QUALITY_MIN_BRILLO=35  IMAGE_QUALITY_MAX_BRILLO=235  IMAGE_QUALITY_MIN_CONTRASTE=15  IMAGE_QUALITY_MIN_NITIDEZ=25
# IMAGE_QUALITY_PUBLICABLE_MIN_BRILLO=70  IMAGE_QUALITY_PUBLICABLE_MAX_BRILLO=225
# IMAGE_QUALITY_PUBLICABLE_MIN_CONTRASTE=28  IMAGE_QUALITY_PUBLICABLE_MIN_NITIDEZ=45

# ── Pipeline de imágenes (docs/PIPELINE_IMAGENES.md) ─────────────────────────
# openai     → IA real: OpenAI GPT Image (principal). De pago por imagen.
# replicate  → IA real: FLUX.1 Kontext [pro] (opcional). De pago por imagen.
# local      → ajuste técnico con sharp (NO es IA): desarrollo sin costo / respaldo
# none       → apagado: se muestra siempre la foto original
# Sin definir: openai si hay OPENAI_API_KEY; si no, replicate si hay token; si no, local.
IMAGE_AI_PROVIDER=openai
OPENAI_API_KEY=                                               # solo backend, nunca en la app ni en git
# OPENAI_IMAGE_MODEL=gpt-image-1-mini                         # el más económico; gpt-image-1 / gpt-image-1.5 = más fidelidad y costo
# OPENAI_IMAGE_QUALITY=medium                                 # low | medium | high
# REPLICATE_API_TOKEN=                                        # solo con IMAGE_AI_PROVIDER=replicate
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro
# IMAGE_AI_PROMPT=...                                         # opcional: reemplaza el prompt por defecto (prompts.js)
# IMAGE_AI_TIMEOUT_MS=120000
# IMAGE_AI_MIN_SIMILITUD=0.55                                 # validación: similitud estructural mínima con el original
# IMAGE_AI_MAX_SUBIDA_SATURACION=0.20                         # validación: subida máxima de saturación media
# IMAGE_PIPELINE_ALLOWED_HOSTS=                               # hosts extra para descargar originales (además de SUPABASE_URL)

# ── IA de texto: descripción propuesta (docs/IA_DESCRIPCIONES.md) ─────────────
# gemini → Gemini 3.5 Flash-Lite (principal). gemini-2.5-flash-lite ya no está disponible para claves nuevas (404)
# openai → reservado, aún no implementado para texto (se trata como none)
# none   → apagado: el botón responde "no disponible" y no se llama a nadie
# Sin definir: gemini si hay GEMINI_API_KEY; si no, none.
TEXT_AI_PROVIDER=gemini
GEMINI_API_KEY=                                               # solo backend, nunca en la app ni en git
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# TEXT_AI_TIMEOUT_MS=10000                                    # 2000–30000
# TEXT_AI_MAX_OUTPUT_TOKENS=160                               # 32–400
# TEXT_AI_TEMPERATURE=0.4                                     # 0–1
# TEXT_AI_MAX_PER_MINUTE=5                                    # por restaurante
# TEXT_AI_DAILY_LIMIT=30                                      # por restaurante y día (Guatemala)
# TEXT_AI_GLOBAL_DAILY_LIMIT=500                              # todo el backend por día
